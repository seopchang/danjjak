rules_version = '2';

// 단짝 보안 규칙.
// 로그인한 사용자는 자기 데이터(users/{uid} 아래)만 읽고 쓸 수 있다.
// decks/words/sessions 컬렉션과 state/character 문서가 모두 이 한 줄에 걸린다.
// Firebase 콘솔 → Firestore Database → 규칙 탭에 이 내용을 붙여넣고 게시하세요.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
